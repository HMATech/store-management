# Copy to .env and fill in. docker compose reads .env from the repo root. Never commit .env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=store-management
JWT_AUDIENCE=store-management
JWT_EXPIRATION_MINUTES=720

# A browser origin allowed to call the API directly, such as a frontend hosted elsewhere. The web container
# reaches the API through its own /api, so it needs none. Leave empty to allow no browser origin.
CORS_ALLOWED_ORIGIN=

# Created on first start when the database has no users. Needs 8+ characters with upper and lower case letters, a
# number and one of #?!@$%^&*-
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=
INITIAL_USER_FIRST_NAME=Owner

# The app, for browsers and phones: http://<this computer's address>:WEB_PORT
WEB_PORT=8081
# The API on its own, for Swagger and tools.
API_PORT=8080
