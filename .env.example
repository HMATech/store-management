# Copy to .env and fill in. docker compose reads .env from the repo root. Never commit .env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=store-management
JWT_AUDIENCE=store-management
JWT_EXPIRATION_MINUTES=720

# The frontend's origin, such as https://warung.example.com. Leave empty to allow no browser origin.
CORS_ALLOWED_ORIGIN=

# Created on first start when the database has no users. Needs 8+ characters with upper and lower case letters, a
# number and one of #?!@$%^&*-
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=
INITIAL_USER_FIRST_NAME=Owner

API_PORT=8080
